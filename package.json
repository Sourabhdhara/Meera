  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "app": "electron electron/main.cjs",
    "electron": "electron electron/main.cjs",
    "server": "node dist/server.cjs",
    "start": "node -e \"const { spawn } = require('child_process'); if (process.platform === 'win32') { spawn('cmd.exe', ['/c', 'set ELECTRON_RUN_AS_NODE=& electron electron/main.cjs'], { stdio: 'inherit', shell: true }); } else { spawn('electron', ['electron/main.cjs'], { stdio: 'inherit' }); }\"",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdf-parse": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "screenshot-desktop": "^1.15.8",
    "sql.js": "^1.15.2",
    "tesseract.js": "^7.0.0",
